# Reparo Environment Template
APP_NAME=Reparo
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8001
FRONTEND_URL=http://localhost:80
API_BASE_URL=http://localhost:8001/api/v1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CORS_ALLOWED_ORIGINS_PATTERNS=

BACKEND_PORT=8001
FRONTEND_PORT=80
SEED_DEMO_DATA=true

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-your-server-key
MIDTRANS_CLIENT_KEY=Mid-client-your-client-key
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_WEBHOOK_URL=

# Cloudflare Tunnels (Optional - leave empty for local development)
TUNNEL_FRONTEND_TOKEN=
TUNNEL_BACKEND_TOKEN=
